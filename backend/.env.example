# Qloo (get a hackathon key: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15
QLOO_CACHE_TTL_SECONDS=3600

# SQLite for local dev; PostgreSQL URL for deployment (Render gives you one)
DATABASE_URL=sqlite:///./stockrescue.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
