# Qloo (get a hackathon key: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15
QLOO_CACHE_TTL_SECONDS=3600

# SQLite for local dev; PostgreSQL URL for deployment (Render gives you one)
DATABASE_URL=sqlite:///./stockrescue.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# LLM (Person 2) - leave LLM_PROVIDER empty to disable LLM explanations
# LLM_PROVIDER: openai_compatible | anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=800

# Required before exposing the API. JSON object: SHA-256(token) -> retailer ID.
# From the repository root, generate a token with: python scripts/generate_retailer_token.py demo
# RETAILER_API_TOKEN_HASHES='{"<64-character-sha256-hex>":"demo"}'
RETAILER_API_TOKEN_HASHES={}
QLOO_REQUESTS_PER_MINUTE=15
RESCUE_RUNS_PER_MINUTE=5
